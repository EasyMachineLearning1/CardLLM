GIGACHAT_CREDENTIALS=  # обязательный base64-ключ (client_id:client_secret) — без него сервис не стартует
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL="GigaChat-2-Max"
# Проверка SSL включена по умолчанию (безопасно). Отключать ТОЛЬКО для локальной отладки;
# для НУЦ Минцифры дополнительно передайте ca_bundle_file.
GIGACHAT_VERIFY_SSL=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
